flowchart TD
    Open["Открыть планировщик курса"] --> Setup["Задать период и недельные позиции"]
    Setup --> Exclusions["Указать каникулы и исключения"]
    Exclusions --> Calendar["Получить сетку занятий"]
    Open --> Calendar
    Calendar --> Catalog["Открыть программу или выбрать провайдера"]
    Catalog --> Search["Найти материал и выбрать страницу каталога"]
    Search --> Add["Перетащить материал или нажать Добавить"]
    Calendar --> Text["Добавить текстовую запись на занятие"]
    Add --> Link["Сохранить прямую привязку к занятию"]
    Link --> Relation["При необходимости указать связанный урок"]
    Relation --> Bracket["Обновить скобки учебных уроков"]
    Relation --> Summary["Пересчитать материалы провайдеров по урокам"]
    Text --> Change["Сохранить порядок и содержимое"]
    Link --> Change
    Change --> Move["Перенести блок или разделить урок"]
    Move --> Change
    Change --> Undo["Отменить последнее применимое изменение"]
    Change --> Conflict{"Версия курса актуальна?"}
    Conflict -->|"Нет"| Reconcile["Показать конфликт и восстановить согласованное состояние"]
    Conflict -->|"Да"| Saved["Показать подтверждение сохранения"]
    Saved --> Deadline["Задать срок работы отдельным действием"]
    Deadline --> Timeline["Показать срок на календаре и в сводке"]
    Calendar --> Rebuild["Изменить расписание и просмотреть расчёт"]
    Rebuild --> Backlog["Переразместить затронутые занятия из Без даты"]
    Backlog --> Calendar
    Calendar --> Journal["После занятия открыть журнал"]
    Journal --> Fact["Подтвердить план или отметить фактически пройденное"]
    Fact --> History["Сохранить факт и снимки отдельно от плана"]
    History --> FactSummary["Посмотреть журнал и сводку факта"]
    Summary --> Detail["Раскрыть ресурсы выбранного урока"]
    Detail -. "Отдельный этап" .-> Units["Связать учебные элементы с вопросами и критериями"]
    Open -. "Отдельный экран следующего этапа" .-> Gradebook["Открыть ведомость периода"]
    Gradebook --> Columns["Настроить колонки шкалы и веса"]
    Columns --> Marks["Получить баллы и внести ручные отметки"]
    Marks --> Compare["Сверить с рабочей Google таблицей"]
    Compare --> Close["Зафиксировать итог периода"]
    Saved -. "Будущий этап бота" .-> Publish["Опубликовать план и просмотреть объявления"]
    Publish -.-> Reminders["Запланировать уведомления по актуальной версии"]
