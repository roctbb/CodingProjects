APP_NAME=Laravel
APP_ENV=local
RECAPTCHA_ENABLE=false
EMAIL_VERIF_ENABLE=false
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Branding. Empty values preserve the current GeekClass appearance.
BRAND_LOGO_URL=
BRAND_PRIMARY_COLOR=
BRAND_PRIMARY_HOVER_COLOR=
BRAND_PRIMARY_LIGHT_COLOR=
BRAND_SECONDARY_COLOR=
BRAND_ACCENT_COLOR=
BRAND_INFO_COLOR=
BRAND_SUCCESS_COLOR=
BRAND_WARNING_COLOR=
BRAND_DANGER_COLOR=

# Optional dark-theme overrides. When empty, custom light colors are adapted automatically.
BRAND_DARK_PRIMARY_COLOR=
BRAND_DARK_PRIMARY_HOVER_COLOR=
BRAND_DARK_PRIMARY_LIGHT_COLOR=
BRAND_DARK_SECONDARY_COLOR=
BRAND_DARK_ACCENT_COLOR=
BRAND_DARK_INFO_COLOR=
BRAND_DARK_SUCCESS_COLOR=
BRAND_DARK_WARNING_COLOR=
BRAND_DARK_DANGER_COLOR=

# Silaeder example:
# BRAND_LOGO_URL="images/branding/silaeder-logo.png"
# BRAND_PRIMARY_COLOR="#397698"
# BRAND_SECONDARY_COLOR="#EACF72"
# BRAND_ACCENT_COLOR="#FFA117"
# BRAND_INFO_COLOR="#5D8FAB"
# BRAND_WARNING_COLOR="#EB4F27"
# BRAND_DANGER_COLOR="#C92325"
# BRAND_SUCCESS_COLOR="#28A745"
# After changing branding values in a cached environment, run: php artisan config:clear

CRM_OIDC_ENABLED=false
CRM_OIDC_ISSUER=https://lk.silaeder.ru
CRM_OIDC_CLIENT_ID=
CRM_OIDC_CLIENT_SECRET=
CRM_OIDC_REDIRECT_URI=http://localhost/auth/silaeder/callback
CRM_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost/auth/silaeder/logout/callback

USE_INTEGRITY=true

LOG_CHANNEL=stack

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=larasite
DB_USERNAME=root
DB_PASSWORD=pwd

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

GEEKPASTE_URL=https://paste.geekclass.ru
GEEKPASTE_API_KEY=

GPT_KEY=
GPT_MODEL=gpt-5-mini
GPT_ACHIEVEMENT_MODEL=gpt-5.5
GPT_GATEWAY=https://gpt-gateway.ai.medsenger.ru:4443/v1/responses

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_PROXY=
TELEGRAM_TIMEOUT=10
